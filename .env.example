# ============================================================
# Sovereign Policy Grid — Environment Configuration
# Copy this file to .env and fill in real credentials.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Safaricom M-Pesa Daraja API ---
# Get these from https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_from_daraja
MPESA_CALLBACK_URL=https://your-ngrok-url.com/api/mpesa/callback
MPESA_PARTY_A=174379
MPESA_PARTY_B=254712345678
MPESA_ACCOUNT_REF=SOVEREIGN-GRID
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- EVM / Web3 Signer ---
# Treasury wallet that signs and sends native asset transfers
EVM_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
EVM_CHAIN_ID=11155111
EVM_TREASURY_PRIVATE_KEY=0xyour_treasury_wallet_private_key
EVM_TREASURY_ADDRESS=0xYourTreasuryAddress
# Maximum gas price in gwei for server-side transactions
EVM_MAX_GAS_GWEI=50

# --- Agent Identity Registry ---
# Registered agent Ethereum addresses (comma-separated, maps to agent_id)
# These are the addresses that agent signatures must recover to.
AGENT_MPESA_PAYOUT_ADDRESS=0xAgentMpesaPayoutAddress
AGENT_TREASURY_YIELD_ADDRESS=0xAgentTreasuryYieldAddress
AGENT_USDC_BRIDGE_ADDRESS=0xAgentUsdcBridgeAddress

# --- Policy Configuration ---
POLICY_MAX_TX_KES=50000
POLICY_APPROVAL_THRESHOLD_KES=20000
POLICY_REPLAY_WINDOW_MS=60000
